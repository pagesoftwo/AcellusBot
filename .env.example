# Copy this file to ".env" (same folder as AcellusAuto.exe or main.py)
# and fill in your keys. Never share your .env with anyone.

# REQUIRED - free, no card: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=paste-key-here

# OPTIONAL - 2nd free key = 2x quota (one per Google account).
# The bot round-robins and fails over automatically on 429s.
# GEMINI_API_KEY2=paste-second-key-here
# GEMINI_API_KEY3=paste-third-key-here

# OPTIONAL ALTERNATIVES (instead of Gemini - see config.json llm_provider):
# Groq, free no card: https://console.groq.com -> API Keys
#   NOTE: Groq currently offers no vision models on most accounts,
#   so it cannot solve screenshots. Kept for future use.
# GROQ_API_KEY=
